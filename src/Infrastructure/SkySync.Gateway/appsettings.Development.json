{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Yarp": "Debug"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "identity-register-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/auth/register" },
        "Transforms": [ { "PathPattern": "/api/auth/register" } ],
        "AuthorizationPolicy": "Public"
      },
      "identity-login-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/auth/login" },
        "Transforms": [ { "PathPattern": "/api/auth/login" } ],
        "AuthorizationPolicy": "Public"
      },
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/auth/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/auth/{**catch-all}" } ],
        "AuthorizationPolicy": "Authenticated"
      },
      "flight-route": {
        "ClusterId": "flight-cluster",
        "Match": { "Path": "/api/flight/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/flight/{**catch-all}" } ],
        "AuthorizationPolicy": "Authenticated"
      },
      "reservation-route": {
        "ClusterId": "reservation-cluster",
        "Match": { "Path": "/api/reservation/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/reservation/{**catch-all}" } ],
        "AuthorizationPolicy": "Authenticated"
      },
      "payment-route": {
        "ClusterId": "payment-cluster",
        "Match": { "Path": "/api/payment/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/payment/{**catch-all}" } ],
        "AuthorizationPolicy": "Authenticated"
      },
      "notification-route": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/api/notification/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/notification/{**catch-all}" } ],
        "AuthorizationPolicy": "Authenticated"
      }
    },
    "Clusters": {
      "flight-cluster": {
        "Destinations": {
          "flight-destination-1": {
            "Address": "http://localhost:5041"
          }
        },
        "LoadBalancingPolicy": "RoundRobin"
      },
      "reservation-cluster": {
        "Destinations": {
          "reservation-destination-1": {
            "Address": "http://localhost:5062"
          }
        },
        "LoadBalancingPolicy": "RoundRobin"
      },
      "payment-cluster": {
        "Destinations": {
          "payment-destination-1": {
            "Address": "http://localhost:5124"
          }
        },
        "LoadBalancingPolicy": "RoundRobin"
      },
      "notification-cluster": {
        "Destinations": {
          "notification-destination-1": {
            "Address": "http://localhost:5042"
          }
        },
        "LoadBalancingPolicy": "RoundRobin"
      },
      "identity-cluster": {
        "Destinations": {
          "identity-destination-1": {
            "Address": "http://localhost:5050"
          }
        },
        "LoadBalancingPolicy": "RoundRobin"
      }
    }
  }
}
