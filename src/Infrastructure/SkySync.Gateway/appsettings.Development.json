{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Yarp": "Debug"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "identity-register-v1": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/v1/auth/register" },
        "Transforms": [ { "PathPattern": "/api/v1/auth/register" } ],
        "AuthorizationPolicy": "Public"
      },
      "identity-login-v1": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/v1/auth/login" },
        "Transforms": [ { "PathPattern": "/api/v1/auth/login" } ],
        "AuthorizationPolicy": "Public"
      },
      "identity-v1": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/v1/auth/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/v1/auth/{**catch-all}" } ],
        "AuthorizationPolicy": "Authenticated"
      },
      "flight-v1": {
        "ClusterId": "flight-cluster",
        "Match": { "Path": "/api/v1/flight/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/v1/flight/{**catch-all}" } ],
        "AuthorizationPolicy": "Authenticated"
      },
      "reservation-v1": {
        "ClusterId": "reservation-cluster",
        "Match": { "Path": "/api/v1/reservation/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/v1/reservation/{**catch-all}" } ],
        "AuthorizationPolicy": "Authenticated"
      },
      "payment-v1": {
        "ClusterId": "payment-cluster",
        "Match": { "Path": "/api/v1/payment/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/v1/payment/{**catch-all}" } ],
        "AuthorizationPolicy": "Authenticated"
      },
      "notification-v1": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/api/v1/notification/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/v1/notification/{**catch-all}" } ],
        "AuthorizationPolicy": "Authenticated"
      },
      "identity-register-legacy": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/auth/register" },
        "Transforms": [ { "PathPattern": "/api/v1/auth/register" } ],
        "AuthorizationPolicy": "Public"
      },
      "identity-login-legacy": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/auth/login" },
        "Transforms": [ { "PathPattern": "/api/v1/auth/login" } ],
        "AuthorizationPolicy": "Public"
      },
      "identity-legacy": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/auth/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/v1/auth/{**catch-all}" } ],
        "AuthorizationPolicy": "Authenticated"
      },
      "flight-legacy": {
        "ClusterId": "flight-cluster",
        "Match": { "Path": "/api/flight/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/v1/flight/{**catch-all}" } ],
        "AuthorizationPolicy": "Authenticated"
      },
      "reservation-legacy": {
        "ClusterId": "reservation-cluster",
        "Match": { "Path": "/api/reservation/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/v1/reservation/{**catch-all}" } ],
        "AuthorizationPolicy": "Authenticated"
      },
      "payment-legacy": {
        "ClusterId": "payment-cluster",
        "Match": { "Path": "/api/payment/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/v1/payment/{**catch-all}" } ],
        "AuthorizationPolicy": "Authenticated"
      },
      "notification-legacy": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/api/notification/{**catch-all}" },
        "Transforms": [ { "PathPattern": "/api/v1/notification/{**catch-all}" } ],
        "AuthorizationPolicy": "Authenticated"
      }
    },
    "Clusters": {
      "flight-cluster": {
        "Destinations": { "flight-destination-1": { "Address": "http://localhost:5041" } },
        "LoadBalancingPolicy": "RoundRobin"
      },
      "reservation-cluster": {
        "Destinations": { "reservation-destination-1": { "Address": "http://localhost:5062" } },
        "LoadBalancingPolicy": "RoundRobin"
      },
      "payment-cluster": {
        "Destinations": { "payment-destination-1": { "Address": "http://localhost:5124" } },
        "LoadBalancingPolicy": "RoundRobin"
      },
      "notification-cluster": {
        "Destinations": { "notification-destination-1": { "Address": "http://localhost:5042" } },
        "LoadBalancingPolicy": "RoundRobin"
      },
      "identity-cluster": {
        "Destinations": { "identity-destination-1": { "Address": "http://localhost:5050" } },
        "LoadBalancingPolicy": "RoundRobin"
      }
    }
  }
}
