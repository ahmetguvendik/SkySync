{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=IdentityServerDb;Username=ahmet;Password=Ahmet.123"
  },
  "JwtSettings": {
    "SecretKey": "YourSuperSecretKeyThatShouldBeAtLeast32CharactersLongForProduction!",
    "Issuer": "SkySync",
    "Audience": "SkySyncUsers",
    "ExpirationMinutes": 60
  },
  "PasswordReset": {
    "TokenExpirationMinutes": 30,
